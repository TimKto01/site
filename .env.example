# Copy to .env, choose a local-only password, and use the same one in DATABASE_URL.
POSTGRES_USER=greenstore
POSTGRES_DB=greenstore
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://greenstore:replace-with-local-password@127.0.0.1:5432/greenstore?schema=public
# External integrations are not implemented yet; no keys are required for the demo.
# Optional bootstrap username; existing accounts are never overwritten.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD: provide securely when invoking admin:create, or leave unset
# to generate a random local password in ignored storage/admin-bootstrap.txt.
# APP_URL: exact public HTTPS origin behind a trusted reverse proxy.
# Leave unset during local development; requests must still have matching Origin/Host.
# UPLOAD_DIR: optional absolute path to persistent uploaded images.
# If unset, storage/uploads under this checkout is used.
